.settings-parent {
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: #000a;
	display: flex;
	justify-content: center;
	align-items: center;
	position: absolute;
}

.settings-root {
	width: 70%;
	height: 80%;
	font-size: 1em;
	box-sizing: border-box;
	overflow: hidden;
	display: flex;
	flex-direction: row;
}

/* Keep dialog content legible when a device skin sets a dark body colour. */
.settings-root.dialogbox {
	color: #f3f5f4;
	background-color: rgb(43,53,58);
	border-color: rgb(172,176,179);
}

.settings-table {
	column-gap: 1em;
	padding-top: 0.1em;
	padding-bottom: 0.1em;
}

.settings-tr {
	padding-top: 0.1em;
	padding-bottom: 0.1em;
}

.settings-td {
	padding: 0.15em 0.5em 0.15em 0.5em;
}

.settings-categories {
	background-color: rgb(28,35,39);
	border-right: 1dp rgb(92,105,111);
	flex: 0 0 auto;
	width: 15em;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	align-items: stretch;
	overflow: hidden;
}

.settings-header {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 0.75em;
	padding: 0.75em;
	border-bottom: 1dp rgb(92,105,111);
	box-sizing: border-box;
}

.settings-category-list {
	flex: 1 1 auto;
	min-height: 0px;
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: 0.5em;
	padding: 0.75em;
	box-sizing: border-box;
	overflow-x: hidden;
	overflow-y: auto;
}

.settings-pagecontainer {
	flex: 1 1 auto;
	min-width: 0px;
	min-height: 0px;
	padding: 1em;
	box-sizing: border-box;
	background-color: rgb(43,53,58);
	overflow-x: hidden;
	overflow-y: auto;
}

.settings-root .settings-category-button
{
	flex: 0 0 auto;
	width: 100%;
	height: 2em;
	min-height: 2em;
	line-height: 1.15em;
	font-size: 1.05em;
	color: #f3f5f4;
	padding: 0.35em 0.65em 0.35em 0.65em;
	box-sizing: border-box;
}

.settings-root .settings-category-button:checked
{
	background-color: rgb(67,82,90);
	border-color: rgb(222,228,230);
	border-width: 2dp;
}

.settings-root .settings-close-button {
	flex: 0 0 auto;
	width: 2.25em;
	height: 2.25em;
	min-width: 2.25em;
	min-height: 2.25em;
	font-size: 1.1em;
	line-height: 1.1em;
	color: #f3f5f4;
	padding: 0.5em;
	box-sizing: border-box;
	text-align: center;
}

.settings-headline {
	font-size: 1.5em;
	font-weight: bold;
	color: #f3f5f4;
}

.settings-advanced-toggle {
	flex: 0 0 auto;
	min-height: 2.5em;
	padding: 0.75em;
	box-sizing: border-box;
	border-top: 1dp rgb(92,105,111);
	background-color: rgb(34,42,46);
}

.settings-page h1 {
	padding-bottom: 0.2em;
	padding-top: 0.2em;
	font-size: 2em;
	display: block;
	width: 100%;
	text-align: center;
	color: #f3f5f4;
	background-color: rgb(32,40,44);
	border-radius: 0.3em;
}
.settings-page h2 {
	padding-bottom: 0.2em;
	padding-top: 0.2em;
	font-size: 1.5em;
	display: block;
	width: 100%;
	text-align: center;
	color: #f3f5f4;
}
.settings-page h3 {
	padding-bottom: 0.2em;
	padding-top: 0.2em;
	font-size: 1.2em;
	display: block;
	width: 100%;
	text-align: center;
	color: #f3f5f4;
}

.settings-combo {
	border: 0.1em #aaa;
	background-color: #0008;
	border-radius: 0.4em;
	width: 16em;
	height: 1.2em;
	padding-left: 0.3em;
}

.settings-combo combotext
{
	line-height: 1.2em;
	height: 100%;
}

.settings-checkbox {
	display: block;
	position: relative;
	width: 1.2em;
	min-width: 1.2em;
	height: 1.2em;
	border: 0.1em #aaa;
	background-color: #0008;
	border-radius: 0.3em;
}

.settings-checkbox:checked {
	decorator: image(check.png fill);
	image-color: #0f8;
}

.settings-checkbox:disabled {
	opacity: 0.2;
}

.settings-hlayout {
	display: flex;
	align-items: center;
	gap: 1em;
}

settingsspacer1 {
	display: block; 
	height: 1em
}

.settings-checkboxwithlabel {
	display: flex;
	align-items: center;
	gap: 0.5em;
}

.settings-slider-h {
	width: 20em; 
	height: 2em;
	background-color: #7775;
	border-radius: 1em;
}

.settings-slider-h sliderbar {
	width: 2em; 
	height: 2em;
	background-color: #000a;
	border-radius: 1em;
}

.settings-advanced {
}

.settings-advanced:disabled {
	opacity: 0.5;
	pointer-events: none;
}
