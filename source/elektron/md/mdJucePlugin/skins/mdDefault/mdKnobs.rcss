/* Legacy model-local cap atlases retained for source/history comparison.
   Active standard caps come from elektron_panel.rcss; the sound wheel remains
   model-specific below. */

@spritesheet mdKnobBlankSheet
{
	mdKnobBlank_000: 0px 0px 96px 96px;
	mdKnobBlank_001: 0px 0px 96px 96px;
	src: mdKnobLineFree.png;
}

