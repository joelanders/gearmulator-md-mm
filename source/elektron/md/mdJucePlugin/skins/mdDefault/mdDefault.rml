				<div class="juceLabel mdYesNoLabel">NO</div>
			</div>
			<button id="btExit" class="juceButton elektronButton elektronKey elektronKey--light mdYesNo" isToggle="0"/>
		</div>
		<button id="btLeft" class="jucePos juceButton elektronButton elektronKey" isToggle="0" style="left: 467dp; top: 377dp;"><div class="elektronButtonGlyph mdIconLeft"/></button>
		<button id="btDown" class="jucePos juceButton elektronButton elektronKey" isToggle="0" style="left: 527dp; top: 377dp;"><div class="elektronButtonGlyph mdIconDown"/></button>
		<button id="btRight" class="jucePos juceButton elektronButton elektronKey" isToggle="0" style="left: 587dp; top: 377dp;"><div class="elektronButtonGlyph mdIconRight"/></button>

		<!-- Transport and the distinct PATTERN/SONG + KIT section. -->

		<div class="jucePos mdTransportIcon mdRecordIcon" style="left: 728dp; top: 358dp; width: 7dp; height: 8dp;"/>
