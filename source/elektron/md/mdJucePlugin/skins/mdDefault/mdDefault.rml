		<div class="jucePos mdTransportIcon mdStopIcon" style="left: 845dp; top: 358dp; width: 8dp; height: 8dp;"/>
		<div id="ledRecord" class="jucePos elektronLed mdTempoLed" style="left: 688dp; top: 387dp;"/>
