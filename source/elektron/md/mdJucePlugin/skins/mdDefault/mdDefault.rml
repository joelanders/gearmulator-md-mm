				<div class="juceLabel elektronStepLegend mdTrigLegend primary"><div class="mdTrigNum">13</div>
				<div class="mdTrigName">M1</div>
				</div></div>
			<div class="elektronStepCell"><div id="stepLed13" class="elektronLed elektronStepLed mdStepLed"/>
