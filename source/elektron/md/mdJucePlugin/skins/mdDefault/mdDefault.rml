		<div class="jucePos elektronLabeledButtonRow" style="left: 356dp; top: 327dp; width: 90dp; height: 28dp;">
			<div class="elektronTwoLineLabel elektronKeyPairLabel">
				<div class="juceLabel mdYesNoLabel elektronActionLabel">ENTER</div>
				<div class="juceLabel mdYesNoLabel">YES</div>
			</div>
			<button id="btEnter" class="juceButton elektronButton elektronKey elektronKey--light mdYesNo" isToggle="0"/>
		</div>
		<button id="btUp" class="jucePos juceButton elektronButton elektronKey" isToggle="0" style="left: 527dp; top: 327dp;"><div class="elektronButtonGlyph mdIconUp"/></button>
		<div class="jucePos elektronLabeledButtonRow" style="left: 356dp; top: 377dp; width: 90dp; height: 28dp;">
			<div class="elektronTwoLineLabel elektronKeyPairLabel">
