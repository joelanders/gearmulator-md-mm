				<div class="juceLabel elektronStepLegend mdTrigLegend primary"><div class="mdTrigNum">9</div>
				<div class="mdTrigName">CH</div>
				</div></div>
			<div class="elektronStepCell"><div id="stepLed9" class="elektronLed elektronStepLed mdStepLed"/>
				<button id="trigKey9" class="juceButton elektronStepKey mdTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mdTrigLegend"><div class="mdTrigNum">10</div>
				<div class="mdTrigName">OH</div>
				</div></div>
			<div class="elektronStepCell"><div id="stepLed10" class="elektronLed elektronStepLed mdStepLed"/>
				<button id="trigKey10" class="juceButton elektronStepKey mdTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mdTrigLegend"><div class="mdTrigNum">11</div>
				<div class="mdTrigName">RC</div>
				</div></div>
			<div class="elektronStepCell"><div id="stepLed11" class="elektronLed elektronStepLed mdStepLed"/>
