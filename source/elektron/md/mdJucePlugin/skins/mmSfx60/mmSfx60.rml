				</div>
			<div class="elektronStepCell"><div id="stepLed4" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey4" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber primary">5</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed5" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey5" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">6</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed6" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey6" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">7</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed7" class="elektronLed elektronStepLed mmStepLed"/>
