		<div id="trigModeAll" class="jucePos juceLabel mmTrigModeLabel mmAffordance" title="Select ALL trig mode" style="left: 999dp; top: 406dp; width: 26dp; height: 14dp; line-height: 14dp;">ALL</div>
		<div class="jucePos juceLabel mmKeyLabel" style="left: 1022dp; top: 348dp; width: 68dp; height: 13dp; line-height: 13dp;">TRIG SELECT</div>
		<div class="jucePos elektronCaptionedKey" style="left: 1028dp; top: 377dp;">
			<button id="btTrigSelect" class="juceButton elektronButton elektronKey mmTrigSelect" isToggle="0"/>
			<div id="altMidiSeq" class="juceLabel elektronButtonCaption elektronSecondary mmAffordance" title="FUNCTION + TRIG SELECT: MIDI sequencer">MIDI SEQ</div>
		</div>

		<!-- Sixteen compact trig keys with external number strips. -->

		<div class="jucePos elektronStepStrip" style="left: 37dp; top: 448dp; width: 960dp; height: 89dp;">
			<div class="elektronStepCell"><div id="stepLed0" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey0" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
