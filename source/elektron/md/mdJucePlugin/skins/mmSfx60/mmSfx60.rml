				<div class="juceLabel elektronStepLegend mmTrigNumber">8</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed8" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey8" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber primary">9</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed9" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey9" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">10</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed10" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey10" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">11</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed11" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey11" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">12</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed12" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey12" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber primary">13</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed13" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey13" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">14</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed14" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey14" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">15</div>
				</div>
			<div class="elektronStepCell"><div id="stepLed15" class="elektronLed elektronStepLed mmStepLed"/>
				<button id="trigKey15" class="juceButton elektronStepKey mmTrig" isToggle="0"/>
				<div class="juceLabel elektronStepLegend mmTrigNumber">16</div>
				</div>
		</div>

		<!-- Pattern-page indicators and compact Scale key. -->

		<div class="jucePos elektronScaleCluster" style="left: 1002dp; top: 443dp; width: 77dp; height: 94dp;">
			<div class="elektronScaleRule">
				<div class="elektronInterruptedRuleRail"/>
				<div class="juceLabel elektronScaleHeading">1/64</div>
				<div class="elektronInterruptedRuleRail"/>
			</div>
			<div class="elektronScalePages">
				<div class="elektronScaleCell">
