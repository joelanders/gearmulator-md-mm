/* Landscape iPhone control surface. The 874 x 400 logical canvas mirrors the
   1748 x 800 design reference at 2x, and all important edges use integer dp. */

body
{
	background-color: #cfd0cb;
	color: #30312d;
	font-family: Roboto;
	overflow: hidden;
}

.mobileChassis
{
	background-color: #cfd0cb;
	border: 1dp #70716c;
}

.mobileGroup
{
	border: 1dp #a6a7a1;
	box-sizing: border-box;
}

.mobileHeading, .mobileLabel, .mobileAlt, .mobilePadLegend
{
	overflow: hidden;
	text-align: center;
	white-space: nowrap;
}

.mobileHeading
{
	color: #754035;
	font-size: 8dp;
	font-weight: bold;
	letter-spacing: 1dp;
}

.mobileLabel
{
	color: #353630;
	font-size: 8dp;
	font-weight: bold;
}

.mobileHint
{
	background-color: #f5f4ef;
	color: #292a27;
	font-size: 9dp;
	letter-spacing: 1dp;
	overflow: hidden;
	text-align: center;
	white-space: nowrap;
}

.mobileKey
{
	height: 26dp;
	width: 44dp;
}

.mobileKeyWide
{
	height: 26dp;
	width: 50dp;
}

.mobileKeyLight
{
	background-color: #dfded7;
	color: #30312d;
}

.mobileAlt
{
	background-color: #743d33;
	color: #eee9df;
	font-size: 7dp;
	font-weight: bold;
	height: 11dp;
	line-height: 11dp;
}

.mobileLed
{
	border-radius: 4dp;
	height: 8dp;
	width: 8dp;
}

.mobileLcdFrame
{
	background-color: #20211f;
	border: 2dp #6c392f;
}

.mobileLcd
{
	background-color: #e0472b;
	border: 1dp #38100a;
}

/* These controls intentionally have no visual treatment. Their rectangles
   coincide with the value fields drawn by the live LCD framebuffer. */
.mobileDisplayEncoder
{
	background-color: #00000000;
	border: 0dp;
	decorator: none;
	opacity: 0;
	pointer-events: auto;
	position: absolute;
}

.mobilePageLegend
{
	background-color: #38100acc;
	color: #f6b19d;
	font-size: 7dp;
	font-weight: bold;
	height: 12dp;
	line-height: 12dp;
	text-align: center;
}

.mobileBankRow
{
	align-items: center;
	display: flex;
	flex-direction: row;
	gap: 5dp;
	height: 42dp;
}

.mobileBankLetters
{
	font-size: 9dp;
	font-weight: bold;
	height: 28dp;
	line-height: 14dp;
	text-align: center;
	width: 24dp;
}

.mobileTransportIcon
{
	color: #31322f;
	font-size: 13dp;
	font-weight: bold;
	height: 17dp;
	line-height: 17dp;
	text-align: center;
	width: 44dp;
}

.mobileRecordIcon
{
	color: #d9533c;
}

.mobileStatusRow
{
	align-items: center;
	display: flex;
	flex-direction: row;
	gap: 4dp;
	height: 14dp;
}

.mobileStatusRow .mobileLabel
{
	font-size: 7dp;
	text-align: left;
}

.mobileNavLabel
{
	font-size: 7dp;
	height: 26dp;
	line-height: 13dp;
	text-align: right;
	width: 39dp;
}

.mobileArrow
{
	height: 26dp;
	width: 44dp;
}

.mobileStepStrip
{
	display: flex;
	flex-direction: row;
	gap: 4dp;
}

.mobileStepCell
{
	align-items: center;
	display: flex;
	flex-direction: column;
	height: 87dp;
	width: 50dp;
}

.mobileStepKey
{
	height: 48dp;
	margin-top: 4dp;
	width: 48dp;
}

.mobilePadLegend
{
	background-color: #e3e2dc;
	border: 1dp #999a94;
	box-sizing: border-box;
	color: #393a35;
	font-size: 7dp;
	height: 13dp;
	line-height: 11dp;
	margin-top: 3dp;
	width: 48dp;
}

.mobilePadLegend.primary
{
	background-color: #7b4035;
	border-color: #7b4035;
	color: #f0eee7;
}

.mobilePadNumber
{
	left: 3dp;
	position: absolute;
	top: 0dp;
}

.mobilePadName
{
	position: absolute;
	right: 3dp;
	top: 0dp;
}

.mobileScalePages
{
	display: flex;
	flex-direction: row;
	gap: 5dp;
}

.mobileScalePage
{
	align-items: center;
	display: flex;
	flex-direction: column;
	font-size: 6dp;
	height: 25dp;
	width: 17dp;
}

.mobileScalePage .mobileLed
{
	margin-bottom: 2dp;
}
