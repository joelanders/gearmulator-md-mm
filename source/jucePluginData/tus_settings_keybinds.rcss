.keybind-list {
	display: block;
	width: 100%;
}

.keybind-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 0.75em;
	padding: 0.2em 0.4em 0.4em 0.4em;
	border-bottom: 2dp rgb(92, 105, 111);
	box-sizing: border-box;
	font-weight: bold;
	color: rgb(200, 210, 215);
}

.keybind-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 0.75em;
	padding: 0.25em 0.4em;
	border-bottom: 1dp rgb(55, 66, 72);
	box-sizing: border-box;
	min-height: 1.9em;
}

.keybind-label {
	flex: 1 1 auto;
	min-width: 0px;
}

.keybind-key {
	flex: 0 0 auto;
	width: 7em;
	text-align: center;
	background-color: rgb(28, 35, 39);
	border-radius: 0.25em;
	padding: 0.1em 0.4em;
	box-sizing: border-box;
}

.keybind-header-key {
	width: 7em;
	text-align: center;
}

.keybind-header-btn {
	width: 5.5em;
}

.keybind-row--capturing {
	background-color: rgb(22, 48, 68);
}

.keybind-row--capturing .keybind-key {
	color: rgb(130, 190, 250);
	background-color: rgb(18, 42, 62);
}

.keybind-row--capturing .settings-checkbox {
	background-color: rgb(20, 55, 90);
	border-color: rgb(70, 140, 200);
}

.keybind-status {
	color: rgb(90, 185, 110);
}
